FROM python:3.11-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1

# Install dependencies (CPU-only torch + requirements)
COPY requirements.txt ./
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r requirements.txt

# Pre-download the model into the image
RUN python -c "from transformers import BlipForConditionalGeneration, BlipProcessor; \
    m='Salesforce/blip-image-captioning-base'; \
    BlipProcessor.from_pretrained(m); \
    BlipForConditionalGeneration.from_pretrained(m)"

COPY img_to_prompt.py ./
COPY worker.py ./

CMD ["python", "worker.py"]